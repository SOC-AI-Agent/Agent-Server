# Copy this file to .env.local if you run the frontend standalone (npm run dev)
# instead of through docker compose (which injects the same values from the
# root .env automatically — see the "NEXT_PUBLIC_BASE_URL, ..." section):
#   cp .env.example .env.local
#
# These are NEXT_PUBLIC_* vars, so they are read by the browser, not the
# frontend server — point them at whatever host/port the API and llama.cpp
# are actually reachable at from wherever you open the app in a browser.

NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BASE_PATH=/restful
NEXT_PUBLIC_LLM_BASE_URL=http://localhost:8080
