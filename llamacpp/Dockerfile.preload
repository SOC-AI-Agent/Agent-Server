# The downloader dall-m-model-preload runs (preload_models.py). Python's
# huggingface_hub rather than llama-server's own downloader, because
# llama-server ignores HTTPS_PROXY and the production host reaches Hugging Face
# only through the office proxy.
FROM python:3.12-slim

RUN pip install --no-cache-dir "huggingface_hub>=2.2,<3"

# Plain HTTPS downloads from huggingface.co, the same requests llama-server
# would make, rather than the Xet storage protocol: an office proxy passes the
# first and may not pass the second.
ENV HF_HUB_DISABLE_XET=1 \
    HF_HUB_DISABLE_TELEMETRY=1

COPY preload_models.py /preload/preload_models.py
ENTRYPOINT ["python", "/preload/preload_models.py"]
