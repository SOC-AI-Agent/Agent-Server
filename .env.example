# Copy this file to .env before running `docker compose up -d`:
#   cp .env.example .env
#
# These are also read directly by the one-time bootstrap scripts in script/
# (create_db.py, add_admin_user.py, insert_default_model.py) when run from
# the host, via python-dotenv.
#
# Production does not use most of these values. The deploy job builds .env
# from this file's keys and the GitLab CI/CD variables of the same names, and
# stops if any of DB_USER, DB_PASSWORD, DB_NAME, JWT_SECRET,
# NEXT_PUBLIC_BASE_URL or NEXT_PUBLIC_LLM_BASE_URL is not set there
# (.gitlab-ci.yml, step 0).
#
# The model llama.cpp serves is not set here: it is chosen at the top of
# llamacpp/preload_models.py, the one place.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Used both to initialize the dall-m-db container and to connect to it
# (DB_HOST/DB_PORT below are for host-side scripts; the server container
# talks to the db over the internal network instead, see docker-compose.yml).
DB_HOST=localhost
DB_PORT=5497
DB_USER=dall-m-db
DB_PASSWORD=password123
DB_NAME=dall-m-db

# ── Auth (server/app/module/auth) ───────────────────────────────────────────
# Change JWT_SECRET before deploying anywhere beyond your own machine.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# ── Logging (dall-m-server) ─────────────────────────────────────────────────
# INFO: one line per request (user, status, ms), every agent call (tokens,
# latency, errors) and every change (who created/edited/deleted what).
# DEBUG adds the health checks AI-Service sends every few seconds and a
# 200-character preview of each message and reply.
LOG_LEVEL=INFO

# ── Published port (dall-m-server) ──────────────────────────────────────────
# The host port the API is published on (the container listens on 8000).
# 8001, not 8000: on the production host 8000 belongs to the FastAPI-era
# stack's soc-backend. NEXT_PUBLIC_BASE_URL below and AI-Service's
# LLM_SERVER_URL name the same port. Only if it is taken too: a CI variable of
# the same name, with a port the Backend's inspect_ports job reports free.
SERVER_HOST_PORT=8001

# ── Frontend (Next.js, consumed by the browser — see frontend/.env.example) ─
# Also injected into the dall-m-frontend container by docker-compose.yml.

NEXT_PUBLIC_BASE_URL=http://localhost:8001       # FastAPI server (dall-m-server) — /restful/*
NEXT_PUBLIC_BASE_PATH=/restful
NEXT_PUBLIC_LLM_BASE_URL=http://localhost:8080   # llama.cpp (dall-m-llamacpp) — WebUI/API ตรงๆ

# ── LLM Backend (local llama.cpp OR external OpenAI-compatible API) ──────────
# OpenRouter example (default for VPS demo: free + ultra-cheap models):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...
#   LLM_PROVIDER=openrouter
#   LLM_MODELS=google/gemma-4-31b-it:free,openrouter/free,meta-llama/llama-3.1-8b-instruct,qwen/qwen3.7-flash,google/gemini-2.5-flash-lite
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODELS=google/gemma-4-31b-it:free,openrouter/free,meta-llama/llama-3.1-8b-instruct,qwen/qwen3.7-flash,google/gemini-2.5-flash-lite
